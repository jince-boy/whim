{
  "name": "whim-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "web-types": "./src/types/web-types.json",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^26.0.0",
    "pnpm": ">=12.8.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "run-p type-check:app type-check:node",
    "type-check:app": "vue-tsc --build tsconfig.app.json",
    "type-check:node": "tsc --project tsconfig.node.json",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "pinia": "^4.0.3",
    "screenfull": "^6.0.2",
    "tinycolor2": "^1.6.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.6.3",
    "@types/tinycolor2": "^1.4.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "naive-ui": "^2.45.3",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.9",
    "sass": "^1.105.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vfonts": "^0.0.3",
    "vite": "^8.3.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  }
}
