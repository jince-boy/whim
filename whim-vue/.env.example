# 复制此文件为 .env 后修改配置；真实环境文件不提交到 Git。
# VITE_ 开头的变量会进入前端构建产物，仅用于公开配置。

# 开发服务器端口
VITE_PORT=3000

# 接口公共前缀：以 / 开头，不带末尾 /；开发代理和 Axios 共用此配置
VITE_API_BASE_URL=/api

# 本地测试数据：未配置时开发环境启用、生产构建关闭。
# 显式设置 true 可构建离线演示；设置 false 可在开发环境联调后端。
# VITE_USE_MOCK=true

# 项目标题：浏览器标签、登录页、侧栏和默认水印
VITE_APP_TITLE="Whim Vue"

# 项目描述：登录页介绍和 HTML 页面描述
VITE_APP_DESCRIPTION="Whim 后台管理系统"

# 版权信息：登录页和页面底部
VITE_APP_COPYRIGHT="Copyright © 2025–Present Whim. All Rights Reserved."
