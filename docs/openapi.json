{
  "openapi": "3.0.3",
  "info": {
    "title": "Whim 认证 API",
    "version": "1.0.0",
    "description": "当前仅提供验证码、登录、退出和当前用户信息四个认证接口。用户信息包含有效角色和权限集合，供 Sa-Token 鉴权使用；数据权限解析保留为内部服务。Long 超出 JavaScript 安全整数时序列化为字符串。统一 JSON 响应采用 Result，HTTP 状态与 Result.code 保持一致。"
  },
  "servers": [
    {
      "url": "http://localhost:8089"
    }
  ],
  "tags": [
    {
      "name": "认证"
    }
  ],
  "paths": {
    "/system/auth/captcha": {
      "get": {
        "tags": [
          "认证"
        ],
        "summary": "获取与客户端地址绑定的 GIF 验证码。",
        "operationId": "captcha",
        "description": "验证码和登录无需登录；其他认证操作要求有效登录。",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultCaptcha"
                }
              }
            }
          },
          "400": {
            "description": "参数校验或业务规则不满足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "401": {
            "description": "未登录或令牌失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "403": {
            "description": "缺少操作权限或目标数据不可访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "409": {
            "description": "唯一键冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          }
        }
      }
    },
    "/system/auth/login": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "用户登录并返回认证信息。",
        "operationId": "login",
        "description": "验证码和登录无需登录。验证码按 UUID 和客户端地址一次性校验，有效期 120 秒；缓存不存在（包括已过期或已使用）时返回“验证码已过期，请刷新后重试”，有效验证码答案不匹配时返回“验证码不正确，请重新输入”。验证码校验失败均返回 HTTP 400，Result.code 为 400。 登录或刷新用户信息时保存有效角色与权限码到Sa-Token会话；超级管理员获得全部启用权限码，不使用*通配符。",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultAuthLogin"
                }
              }
            }
          },
          "400": {
            "description": "参数校验或业务规则不满足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                },
                "examples": {
                  "captchaExpired": {
                    "summary": "验证码已过期",
                    "value": {
                      "code": 400,
                      "message": "验证码已过期，请刷新后重试",
                      "data": null,
                      "success": false
                    }
                  },
                  "captchaIncorrect": {
                    "summary": "验证码不正确",
                    "value": {
                      "code": 400,
                      "message": "验证码不正确，请重新输入",
                      "data": null,
                      "success": false
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "未登录或令牌失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "403": {
            "description": "缺少操作权限或目标数据不可访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "409": {
            "description": "唯一键冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLoginRequest"
              }
            }
          }
        }
      }
    },
    "/system/auth/logout": {
      "post": {
        "tags": [
          "认证"
        ],
        "summary": "注销当前登录会话。",
        "operationId": "logout",
        "description": "验证码和登录无需登录；其他认证操作要求有效登录。",
        "parameters": [],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultVoid"
                }
              }
            }
          },
          "400": {
            "description": "参数校验或业务规则不满足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "401": {
            "description": "未登录或令牌失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "403": {
            "description": "缺少操作权限或目标数据不可访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "409": {
            "description": "唯一键冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          }
        }
      }
    },
    "/system/auth/userInfo": {
      "get": {
        "tags": [
          "认证"
        ],
        "summary": "获取当前用户信息和当前有效授权。",
        "operationId": "userInfo",
        "description": "验证码和登录无需登录；其他认证操作要求有效登录。 登录或刷新用户信息时保存有效角色与权限码到Sa-Token会话；超级管理员获得全部启用权限码，不使用*通配符。",
        "parameters": [],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultAuthUser"
                }
              }
            }
          },
          "400": {
            "description": "参数校验或业务规则不满足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "401": {
            "description": "未登录或令牌失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "403": {
            "description": "缺少操作权限或目标数据不可访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "409": {
            "description": "唯一键冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          },
          "500": {
            "description": "服务器错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "AuthLoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "用户名",
            "minLength": 3,
            "maxLength": 32
          },
          "password": {
            "type": "string",
            "description": "密码",
            "minLength": 8,
            "maxLength": 72
          },
          "uuid": {
            "type": "string",
            "description": "验证码 UUID。",
            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}",
            "minLength": 1
          },
          "captchaCode": {
            "type": "string",
            "description": "GIF 图片中的四位字符。",
            "pattern": "[A-Za-z0-9]{4}",
            "minLength": 1
          }
        },
        "required": [
          "username",
          "password",
          "uuid",
          "captchaCode"
        ],
        "description": "登录请求参数"
      },
      "AuthLoginData": {
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "description": "令牌类型"
          },
          "accessToken": {
            "type": "string",
            "description": "访问令牌"
          },
          "expiresIn": {
            "oneOf": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            ],
            "description": "Java Long；响应超出 JavaScript 安全整数范围时为字符串，请保持 ID 原始值。\n剩余有效期，单位为秒"
          }
        },
        "description": "认证成功后的通用令牌信息。"
      },
      "CaptchaData": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "description": "验证码唯一标识。"
          },
          "image": {
            "type": "string",
            "description": "GIF 图片的纯 Base64 编码。"
          },
          "expiresIn": {
            "oneOf": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            ],
            "description": "Java Long；响应超出 JavaScript 安全整数范围时为字符串，请保持 ID 原始值。\n验证码剩余有效期，单位为秒。"
          }
        },
        "description": "登录 GIF 验证码响应参数"
      },
      "AuthUserData": {
        "type": "object",
        "properties": {
          "userId": {
            "oneOf": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            ],
            "description": "Java Long；响应超出 JavaScript 安全整数范围时为字符串，请保持 ID 原始值。\n用户ID"
          },
          "username": {
            "type": "string",
            "description": "用户名"
          },
          "name": {
            "type": "string",
            "description": "真实姓名"
          },
          "avatar": {
            "type": "string",
            "description": "头像地址"
          },
          "deptId": {
            "oneOf": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            ],
            "description": "Java Long；响应超出 JavaScript 安全整数范围时为字符串，请保持 ID 原始值。\n所属部门ID"
          },
          "loginType": {
            "type": "string",
            "description": "账号体系"
          },
          "roleCodeSet": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "角色编码集合"
          },
          "permissionCodeSet": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "权限编码集合"
          },
          "roleInfoList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleInfo"
            },
            "description": "角色信息列表"
          }
        },
        "description": "当前登录用户响应参数。"
      },
      "RoleInfo": {
        "type": "object",
        "properties": {
          "roleId": {
            "oneOf": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            ],
            "description": "Java Long；响应超出 JavaScript 安全整数范围时为字符串，请保持 ID 原始值。\n角色ID"
          },
          "roleName": {
            "type": "string",
            "description": "角色名称"
          },
          "roleCode": {
            "type": "string",
            "description": "角色编码"
          },
          "dataScope": {
            "type": "integer",
            "format": "int32",
            "description": "数据权限范围"
          }
        },
        "description": "当前登录用户角色上下文通用信息。"
      },
      "ErrorResult": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "HTTP 状态码，由统一响应处理器同步到实际 HTTP 响应状态；例如 200、400、401、403、409、429、500。"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true,
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "success": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "code",
          "message",
          "success"
        ]
      },
      "ResultVoid": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "HTTP 状态码，由统一响应处理器同步到实际 HTTP 响应状态；例如 200、400、401、403、409、429、500。"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true,
            "description": "无返回数据，值为 null。"
          },
          "success": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "code",
          "message",
          "data",
          "success"
        ]
      },
      "ResultCaptcha": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "HTTP 状态码，由统一响应处理器同步到实际 HTTP 响应状态；例如 200、400、401、403、409、429、500。"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/CaptchaData"
          },
          "success": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "code",
          "message",
          "data",
          "success"
        ]
      },
      "ResultAuthLogin": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "HTTP 状态码，由统一响应处理器同步到实际 HTTP 响应状态；例如 200、400、401、403、409、429、500。"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/AuthLoginData"
          },
          "success": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "code",
          "message",
          "data",
          "success"
        ]
      },
      "ResultAuthUser": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200,
            "description": "HTTP 状态码，由统一响应处理器同步到实际 HTTP 响应状态；例如 200、400、401、403、409、429、500。"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/AuthUserData"
          },
          "success": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "code",
          "message",
          "data",
          "success"
        ]
      }
    }
  }
}
