    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/tinycolor2": "^1.4.6",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "5.4.21",
    "vitepress": "1.6.4",
    "vue-tsc": "^3.3.11"
  }
}
