{
  "name": "whim-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vitepress dev . --host 127.0.0.1 --port 5175 --strictPort",
    "build": "vitepress build .",
    "preview": "node scripts/preview.mjs",
