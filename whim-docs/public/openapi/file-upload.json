            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": ["file"]
              }
            }
          }
        }
      }
    },
    "/system/fileUpload/tasks/{taskId}/complete": {
      "post": {
        "tags": ["文件上传"],
        "summary": "校验分片并确认上传完成",
        "operationId": "post_fileUpload__tasks__taskId__complete",
        "description": "要求 system:fileUpload:upload，仅限本人。服务端查询真实清单后持久化COMPLETING，再合并及核对正式文件大小。COMPLETED重复调用返回相同任务。响应丢失或500后可重试确认；不接收客户端ETag清单。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [200]
                    },
                    "message": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/FileUploadTask"
                    }
                  },
                  "required": ["code", "message", "success"]
                }
              }
            }
          },
          "400": {
            "description": "参数错误、文件不匹配或任务状态不允许",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "401": {
            "description": "未登录或登录失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "403": {
            "description": "缺少权限，或任务不存在/不属于当前用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "429": {
            "description": "任务正在处理或用户活动任务额度不足，可有限退避重试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "500": {
            "description": "存储或系统故障；不应据此假设上传未发生",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          }
        }
      }
    },
    "/system/fileUpload/tasks/{taskId}/download": {
      "get": {
        "tags": ["文件上传"],
        "summary": "流式下载我的文件",
        "operationId": "get_fileUpload__tasks__taskId__download",
        "description": "要求系统登录和权限 system:fileUpload:download。仅操作本人任务；超级管理员不会扩大个人文件可见范围。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "完整文件附件流；未实现Range续传",
            "headers": {
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "enum": ["nosniff"]
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "参数错误、文件不匹配或任务状态不允许",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "401": {
            "description": "未登录或登录失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "403": {
            "description": "缺少权限，或任务不存在/不属于当前用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "429": {
            "description": "任务正在处理或用户活动任务额度不足，可有限退避重试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "500": {
            "description": "存储或系统故障；不应据此假设上传未发生",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          }
        }
      }
    },
    "/system/permission/userMenus": {
      "get": {
        "tags": ["权限"],
        "summary": "获取当前用户可访问菜单树",
        "operationId": "get__system_permission_userMenus",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "要求系统登录，不要求菜单管理权限。从登录上下文的精确权限码选取启用页面及有效祖先目录，目录不能隐式授予子页面。隐藏页面保留路由；缺失、停用、非目录或循环祖先被排除。返回1目录和2页面，不返回按钮或无权限码的外链。当前权限快照由登录/刷新用户信息建立。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [200]
                    },
                    "message": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/UserMenuNavigation"
                      }
                    }
                  },
                  "required": ["code", "message", "success"]
                }
              }
            }
          },
          "401": {
            "description": "未登录或登录失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "500": {
            "description": "存储或系统故障；不应据此假设上传未发生",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "FileUploadTask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "fileName": {
            "type": "string"
          },
          "fileSize": {
            "type": "integer",
            "format": "int64"
          },
          "contentType": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "客户端原文件SHA-256，仅用于重选原文件，不是服务端全文件校验结论。"
          },
          "partSize": {
            "type": "integer",
            "format": "int64"
          },
          "partCount": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "UPLOADING",
              "COMPLETING",
              "COMPLETED",
              "CANCELING",
              "CANCELED",
              "EXPIRED",
              "FAILED"
            ]
          },
          "directUpload": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": "string",
            "example": "2026-10-23 12:00:00"
          },
          "createTime": {
            "type": "string",
            "example": "2026-10-22 12:00:00"
          },
          "uploadedParts": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "description": "详情返回存储确认的分片；列表、初始化、完成响应为空数组。"
          }
        },
        "required": [
          "id",
          "fileName",
          "fileSize",
          "contentType",
          "fingerprint",
          "partSize",
          "partCount",
          "status",
          "directUpload",
          "expiresAt",
          "createTime",
          "uploadedParts"
        ]
      },
      "FileUploadOptions": {
        "type": "object",
        "properties": {
          "maximumFileSize": {
            "type": "integer",
            "format": "int64",
            "example": 1073741824
          },
          "partSize": {
            "type": "integer",
            "format": "int64",
            "example": 8388608
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "example": 3
          }
        },
        "required": ["maximumFileSize", "partSize", "concurrency"]
      },
      "FileUploadCreate": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "不含目录或控制字符"
          },
          "fileSize": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "不超过实际配置的单文件大小上限，默认1GiB"
          },
          "contentType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "example": "application/octet-stream"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["requestId", "fileName", "fileSize", "contentType", "fingerprint"]
      },
      "FileUploadPartChecksums": {
        "type": "object",
        "properties": {
          "contentMd5": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{22}==$"
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          }
        },
        "required": ["contentMd5", "contentSha256"]
      },
      "FileUploadPartSignature": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "nullable": true,
            "description": "本地模式为null，云模式是原样使用的短期PUT地址"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "云端请求必须携带这些头；Content-Length由浏览器按Blob自动发送。禁止附加应用Authorization。"
          }
        },
        "required": ["headers"]
      },
      "FileUploadPage": {
        "type": "object",
        "properties": {
          "currentPage": {
            "type": "integer",
            "format": "int64"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileUploadTask"
            }
          },
          "pages": {
            "type": "integer",
            "format": "int64"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": ["currentPage", "data", "pages", "size", "total"]
      },
      "FileUploadError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "success": {
            "type": "boolean",
            "enum": [false]
          },
          "data": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": ["code", "message", "success"]
      },
      "UserMenuNavigation": {
        "type": "object",
        "properties": {
          "id": {
            "oneOf": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "string"
              }
            ],
            "description": "JavaScript安全整数范围内为数字，超出为字符串"
          },
          "parentId": {
            "oneOf": [
              {
                "type": "integer",
                "format": "int64"
              },
              {
                "type": "string"
              }
            ],
            "description": "JavaScript安全整数范围内为数字，超出为字符串"
          },
          "routeName": {
            "type": "string",
            "nullable": true
          },
          "menuName": {
            "type": "string"
          },
          "perms": {
            "type": "string",
            "nullable": true
          },
          "menuType": {
            "type": "integer",
            "enum": [1, 2]
          },
          "path": {
            "type": "string",
            "nullable": true
          },
          "component": {
            "type": "string",
            "nullable": true
          },
          "param": {
            "type": "string",
            "nullable": true
          },
          "isCache": {
            "type": "integer",
            "enum": [0, 1]
          },
          "sort": {
            "type": "integer"
          },
          "icon": {
            "type": "string",
            "nullable": true
          },
          "visible": {
            "type": "integer",
            "enum": [0, 1]
          },
          "status": {
            "type": "integer",
            "enum": [0]
          },
          "builtIn": {
            "type": "integer",
            "enum": [0, 1]
          },
          "protectedNode": {
            "type": "boolean",
            "description": "此导航视图不提供菜单维护保护判定，当前为false。"
          },
          "remark": {
            "type": "string",
            "nullable": true
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserMenuNavigation"
            }
          }
        }
      }
    }
  }
}
