              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [200]
                    },
                    "message": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/FileUploadTask"
                    }
                  },
                  "required": ["code", "message", "success"]
                }
              }
            }
          },
          "400": {
            "description": "参数错误、文件不匹配或任务状态不允许",
            "content": {
              "application/json": {
