{
  "openapi": "3.0.3",
  "info": {
    "title": "Whim 文件上传与导航接入",
    "version": "1.0.0",
    "description": "对应本地、MinIO 9.0.3、OSS V2 0.6.1 的分片任务实现。"
  },
  "tags": [
    {
      "name": "文件上传"
    },
    {
      "name": "权限"
    }
  ],
  "paths": {
    "/system/fileUpload/options": {
      "get": {
        "tags": ["文件上传"],
        "summary": "获取上传配置",
        "operationId": "get_fileUpload__options",
        "description": "要求系统登录和权限 system:fileUpload:list。仅操作本人任务；超级管理员不会扩大个人文件可见范围。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [200]
                    },
                    "message": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/FileUploadOptions"
                    }
                  },
                  "required": ["code", "message", "success"]
                }
              }
            }
          },
          "400": {
            "description": "参数错误、文件不匹配或任务状态不允许",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "401": {
            "description": "未登录或登录失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "403": {
            "description": "缺少权限，或任务不存在/不属于当前用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "429": {
            "description": "任务正在处理或用户活动任务额度不足，可有限退避重试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "500": {
            "description": "存储或系统故障；不应据此假设上传未发生",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          }
        }
      }
    },
    "/system/fileUpload/tasks": {
      "get": {
        "tags": ["文件上传"],
        "summary": "分页查询我的上传任务和文件",
        "operationId": "get_fileUpload__tasks",
        "description": "要求系统登录和权限 system:fileUpload:list。仅操作本人任务；超级管理员不会扩大个人文件可见范围。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "pageNum",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
