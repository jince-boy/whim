          },
          "500": {
            "description": "存储或系统故障；不应据此假设上传未发生",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["文件上传"],
        "summary": "幂等创建上传任务",
        "operationId": "post_fileUpload__tasks",
        "description": "要求 system:fileUpload:upload。相同用户+requestId仅对应同一文件，修改文件名、大小、类型或指纹返回400。先持久化任务再初始化存储；超时可用同一请求标识重试。平台、对象键、分片大小由服务端决定。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功",
