          "401": {
            "description": "未登录或登录失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "403": {
            "description": "缺少权限，或任务不存在/不属于当前用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "409": {
            "description": "唯一约束冲突",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "429": {
            "description": "任务正在处理或用户活动任务额度不足，可有限退避重试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "500": {
            "description": "存储或系统故障；不应据此假设上传未发生",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadCreate"
              }
            }
          }
        }
      }
    },
    "/system/fileUpload/tasks/{taskId}": {
