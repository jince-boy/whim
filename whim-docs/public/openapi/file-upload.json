    "/system/fileUpload/tasks/{taskId}/parts/{partNumber}/signature": {
      "post": {
        "tags": ["文件上传"],
        "summary": "登记分片并获取上传签名",
        "operationId": "post_fileUpload__tasks__taskId__parts__partNumber__signature",
        "description": "要求 system:fileUpload:upload，任务须为本人且UPLOADING未过期。首次登记MD5和SHA-256后不可更改。MinIO签名约束x-amz-checksum-sha256及长度，OSS V4约束Content-MD5及长度。本地返回url=null。云端按headers发送Blob PUT，不携带应用Bearer令牌，不手动设置Content-Length。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          },
          {
            "name": "partNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [200]
                    },
                    "message": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean",
                      "enum": [true]
                    },
                    "data": {
                      "$ref": "#/components/schemas/FileUploadPartSignature"
                    }
                  },
                  "required": ["code", "message", "success"]
                }
              }
            }
          },
          "400": {
            "description": "参数错误、文件不匹配或任务状态不允许",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "401": {
            "description": "未登录或登录失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "403": {
            "description": "缺少权限，或任务不存在/不属于当前用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "429": {
            "description": "任务正在处理或用户活动任务额度不足，可有限退避重试",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          },
          "500": {
            "description": "存储或系统故障；不应据此假设上传未发生",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadPartChecksums"
              }
            }
          }
        }
      }
    },
