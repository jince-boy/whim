# 后端专用：复制为仓库根目录 .env；前端使用 whim-vue/.env。
# 密码、私钥使用单引号包裹，避免 $ 被 Compose 展开；真实 .env 不提交到 Git。
TZ=Asia/Shanghai
BACKEND_IMAGE=whim-backend:local
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8089
BACKEND_MEMORY_LIMIT=2g
SHARED_NETWORK_NAME=whim-network

# 服务器宿主机目录，需在启动前创建；files、logs 归 UID/GID 10001 所有。
BACKEND_CONFIG_DIR=./deploy/config
BACKEND_FILES_DIR=/opt/whim/backend/files
BACKEND_LOGS_DIR=/opt/whim/backend/logs
MYSQL_DATA_DIR=/opt/whim/backend/mysql
REDIS_DATA_DIR=/opt/whim/backend/redis
REDIS_CONFIG_FILE=./deploy/redis/redis.conf

# mysql、redis 是后端 Compose 内的服务名；连接已有服务见部署文档。
MYSQL_IMAGE=mysql:8.4
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=whim
MYSQL_USER=whim
MYSQL_PASSWORD=''
MYSQL_ROOT_PASSWORD=''
MYSQL_SSL_MODE=REQUIRED

REDIS_IMAGE=redis:8.4-alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=''

# 填写独立的随机密钥，例如 64 位十六进制随机字符串。
SA_TOKEN_JWT_SECRET=''
# RSA PKCS#8 DER 单行 Base64 私钥；与前端公钥配对，不能放入 VITE_ 变量。
REQUEST_ENCRYPTION_PRIVATE_KEY=''

JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Djava.awt.headless=true -Dfile.encoding=UTF-8'
