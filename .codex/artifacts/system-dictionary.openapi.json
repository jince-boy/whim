    "/system/dictType/update": {
      "put": {
        "tags": [
          "字典类型"
        ],
        "summary": "修改字典类型",
        "operationId": "updateDictType",
        "description": "权限码：system:dictType:update。完整编辑请求；备注省略或null会清空。编码变化时在同一事务内同步未删除数据项的type，保留数据项备注并填充更新审计字段。事务成功后按sort、id升序更新新编码选项缓存，并使旧编码选项缓存和类型详情缓存失效。记录不存在或更新失败时抛出ServiceException。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DictTypeUpdate"
