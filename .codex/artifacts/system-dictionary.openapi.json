    "/system/dictType/reset": {
      "delete": {
        "tags": [
          "字典类型"
        ],
        "summary": "重置字典缓存",
        "operationId": "resetDictCache",
        "description": "权限码：system:dictType:reset。仅清除字典类型缓存sys_dict_type和字典数据缓存sys_dict，不查询数据库或预加载；后续查询通过Cacheable重新加载。",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
