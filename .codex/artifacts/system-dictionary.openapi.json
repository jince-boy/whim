    "/system/dictData/delete": {
      "delete": {
        "tags": [
          "字典数据"
        ],
        "summary": "批量删除字典数据",
        "operationId": "deleteDictData",
        "description": "权限码：system:dictData:delete。单次1至100个ID，直接按传入ID批量删除，不预先查询或校验每个ID是否存在。重复ID不影响删除，部分ID不存在不阻止其余记录删除。没有记录被删除时抛出ServiceException，按全局处理返回500。删除标识写入各行主键；事务成功后清空全部字典选项缓存，后续查询重新加载。",
        "parameters": [
          {
            "name": "dictDataIds",
            "in": "query",
            "required": true,
            "description": "支持逗号分隔或重复参数",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "#/components/schemas/Id"
              }
            }
          }
        ],
        "responses": {
