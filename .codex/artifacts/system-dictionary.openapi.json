{
  "openapi": "3.0.3",
  "info": {
    "title": "Whim 字典类型与字典数据接口",
    "version": "2.0.0",
    "description": "包含14个字典类型和字典数据接口。字典类型与数据项均无状态字段，数据项请求和响应统一使用type编码关联类型。系统共享字典不按部门或创建人隔离。接口使用Result返回响应。"
  },
  "servers": [
    {
      "url": "http://localhost:8089"
    }
  ],
  "tags": [
    {
      "name": "字典类型"
    },
    {
      "name": "字典数据"
    }
  ],
  "security": [
    {
      "SystemToken": []
    }
  ],
  "paths": {
    "/system/dictType/page": {
      "get": {
        "tags": [
          "字典类型"
        ],
        "summary": "分页查询字典类型",
        "operationId": "getDictTypePage",
        "description": "权限码：system:dictType:page。页码从1开始，每页最多100条。",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "description": "名称精确匹配"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "类型编码精确匹配"
          },
          {
            "name": "pageNum",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DictTypePageResult"
                }
              }
            }
          },
          "400": {
            "description": "请求参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登录或会话失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "缺少接口操作权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "业务操作失败（ServiceException）或服务器异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
