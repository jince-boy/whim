{
  "openapi": "3.0.3",
  "info": {
    "title": "Whim 字典导出接口",
    "version": "2.1.0",
    "description": "仅包含本次新增的两个后端导出接口，用于合并更新 Apifox whim 项目。"
  },
  "servers": [
    {
      "url": "http://localhost:8089"
    }
  ],
  "tags": [
    {
      "name": "字典类型"
    },
    {
      "name": "字典数据"
    }
  ],
  "security": [
    {
      "SystemToken": []
    }
  ],
  "paths": {
    "/system/dictType/export": {
      "post": {
        "tags": [
          "字典类型"
        ],
        "summary": "导出字典类型",
        "operationId": "exportDictType",
        "description": "权限码：system:dictType:export。按当前筛选条件导出全部未删除记录，按主键 ID 升序排列。一次查询全部符合条件的记录，不分页、不使用游标，不设置导出总数量上限；每个工作表最多1000000条数据，超过后自动创建后续工作表。无匹配结果时返回带表头的空文件。成功返回 XLSX 二进制，不封装 Result。导出列：字典类型ID、字典名称、字典类型、备注、创建时间、更新时间。主键以文本保存，字典键值保留字符串，时间显示为 yyyy-MM-dd HH:mm:ss。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DictTypeExport"
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "XLSX 文件；无匹配数据时仅含表头",
            "headers": {
              "Content-Disposition": {
                "description": "attachment；UTF-8 文件名为字典类型.xlsx",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "请求参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登录或会话失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "缺少导出权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "响应尚未提交时发生的服务器内部错误；文件开始传输后的失败会中断下载",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/system/dictData/export": {
      "post": {
        "tags": [
          "字典数据"
        ],
        "summary": "导出字典数据",
        "operationId": "exportDictData",
        "description": "权限码：system:dictData:export。按当前筛选条件导出全部未删除记录，按排序值、主键 ID 升序排列。一次查询全部符合条件的记录，不分页、不使用游标，不设置导出总数量上限；每个工作表最多1000000条数据，超过后自动创建后续工作表。无匹配结果时返回带表头的空文件。成功返回 XLSX 二进制，不封装 Result。导出列：字典数据ID、字典类型、字典标签、字典键值、回显样式、排序、备注、创建时间、更新时间。主键以文本保存，字典键值保留字符串，时间显示为 yyyy-MM-dd HH:mm:ss。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DictDataExport"
              },
              "example": {
                "type": "sys_result_status",
                "label": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "XLSX 文件；无匹配数据时仅含表头",
            "headers": {
              "Content-Disposition": {
                "description": "attachment；UTF-8 文件名为字典数据.xlsx",
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "请求参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登录或会话失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "缺少导出权限",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "响应尚未提交时发生的服务器内部错误；文件开始传输后的失败会中断下载",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SystemToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "系统账号登录接口返回的令牌，传入Authorization: Bearer <token>。"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object",
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "DictDataExport": {
        "type": "object",
        "description": "导出当前筛选条件下全部未删除记录，不使用 pageNum、pageSize 或勾选行 ID。",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
            "description": "必须指定所属字典类型编码"
          },
          "label": {
            "type": "string",
            "maxLength": 128,
            "description": "字典标签精确匹配，空白表示不筛选"
          }
        },
        "required": [
          "type"
        ]
      },
      "DictTypeExport": {
        "type": "object",
        "description": "导出当前筛选条件下全部未删除记录，不使用 pageNum、pageSize 或勾选行 ID。",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "description": "字典名称精确匹配，空白表示不筛选"
          },
          "type": {
            "type": "string",
            "maxLength": 128,
            "description": "字典类型编码精确匹配，空白表示不筛选"
          }
        }
      }
    }
  }
}
