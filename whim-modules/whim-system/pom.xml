<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.whim</groupId>
        <artifactId>whim-modules</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>whim-system</artifactId>
    <description>系统业务模块</description>

    <dependencies>
        <!-- 慢 SQL 使用 MVC 已匹配的路由模板和控制器方法定位请求来源 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
        </dependency>
        <!-- 接口监控直接读取 Actuator 已注册的请求计时器 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <!-- 服务器监控使用 JDK 25 外部函数与内存 API 读取本地设备指标 -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core-ffm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>
        <dependency>
            <groupId>com.whim</groupId>
            <artifactId>whim-log</artifactId>
        </dependency>
        <!-- 文件管理复用存储基础设施 -->
        <dependency>
            <groupId>com.whim</groupId>
            <artifactId>whim-file</artifactId>
        </dependency>
        <!-- Excel 业务模型注解和导入导出能力 -->
        <dependency>
            <groupId>com.whim</groupId>
            <artifactId>whim-excel</artifactId>
        </dependency>
        <!-- 核心模块 -->
        <dependency>
            <groupId>com.whim</groupId>
            <artifactId>whim-core</artifactId>
        </dependency>
        <!-- mybatis-plus模块 -->
        <dependency>
            <groupId>com.whim</groupId>
            <artifactId>whim-mybatisplus</artifactId>
        </dependency>
        <!-- redis 模块 -->
        <dependency>
            <groupId>com.whim</groupId>
            <artifactId>whim-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.whim</groupId>
            <artifactId>whim-authenticator</artifactId>
        </dependency>
        <!-- 登录 GIF 验证码 -->
        <dependency>
            <groupId>com.github.whvcse</groupId>
            <artifactId>easy-captcha</artifactId>
        </dependency>
    </dependencies>

</project>
