<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.whim.system.mapper.SysRolePermissionDeptMapper">
    <select id="selectDepartmentIdsByGrants" resultType="java.lang.Long">
        SELECT dept_id FROM sys_role_permission_dept
        WHERE (role_id, permission_id) IN
        <foreach collection="grants" item="grant" open="(" separator="," close=")">
            (#{grant.roleId}, #{grant.permissionId})
        </foreach>
    </select>
</mapper>
