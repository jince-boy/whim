<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.whim.system.mapper.SysTenantMapper">
    <resultMap id="tenantOptionResultMap" type="com.whim.system.model.entity.SysTenant">
        <id column="id" property="id"/>
        <result column="tenant_code" property="tenantCode"/>
        <result column="company_name" property="companyName"/>
    </resultMap>

    <select id="selectAvailableTenantList" resultMap="tenantOptionResultMap">
        SELECT id,
               tenant_code,
               company_name
        FROM sys_tenant
        WHERE deleted = 0
          AND status = 0
          AND (expire_time IS NULL OR expire_time &gt; CURRENT_TIMESTAMP)
        ORDER BY company_name, id
    </select>

    <select id="selectAvailableTenantIds" resultType="java.lang.Long">
        SELECT id
        FROM sys_tenant
        WHERE deleted = 0
          AND status = 0
          AND (expire_time IS NULL OR expire_time &gt; CURRENT_TIMESTAMP)
    </select>
</mapper>

